# Server-only. Copy to .env.local (dev) or .env.production (host).
# Never prefix these with NEXT_PUBLIC_. Never commit real hosts.

# Internal LLM chat endpoint (private DNS). Use a fictional hostname in git.
# Never a real host, Tailscale 100.x, or LAN 192.168.x.
OLLAMA_HOST=http://llm-internal:11434
OLLAMA_MODEL=instruct-7b

# Public GA4 web stream. Empty disables the gtag script. Do not commit a real ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Archive flip. 0/empty = live capture. 1 = serve frozen snapshot only.
# Cutoff is 24 Oct 2026 12:00 America/Sao_Paulo (15:00Z).
OFFLINE_MODE=0
OFFLINE_CUTOFF_ISO=2026-10-24T15:00:00.000Z

# Optional. launchd label on the origin host. Fictional default; set the real
# label only in the ignored .env.production on that host.
CROSSNEWS_LAUNCHD_LABEL=origin-app
